#!/usr/bin/env bash
# Record and verify a consumer's position against Friday's managed core.
#
#   bin/friday-lock write <target>    write or refresh <target>/.friday-lock.json
#   bin/friday-lock check [<target>]  verify it  (default target: the cwd)
#
# The states, and the distinction matters:
#
#   in sync   every recorded file matches, and the payload has not moved
#   drifted   a file in the target no longer matches what the lock recorded
#             -- somebody edited a managed-core file in the consumer
#   behind    the payload's content moved since the lock was written, or a
#             file joined the managed core -- Friday shipped a change the
#             consumer has not taken
#   retired   the lock records a file Friday no longer manages -- deleting it
#             or keeping it as the consumer's own is a person's call
#   ahead / diverged   see the commit comparison below
#
# `behind` is decided by comparing CONTENT, never by comparing commits. A
# Friday commit that only touches a README moves no payload hash and so
# produces no `behind`, which is what keeps a scheduled check quiet enough to
# be worth running daily.
#
# Only a payload consumer has a record. Friday tracks no copy of its hooks
# anywhere else: a repository that wants them either adopts the payload or
# keeps its own.
set -uo pipefail

# FRIDAY_KIT_ROOT lets friday-propagate run a copy of this script taken from
# its pinned commit, while still reading this checkout's repository.
KIT_ROOT=${FRIDAY_KIT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
PAYLOAD="$KIT_ROOT/payload"
LIST="$KIT_ROOT/bin/managed-core.txt"
CONSUMER_LOCK=.friday-lock.json

die() { echo "friday-lock: $*" >&2; exit 2; }

command -v jq >/dev/null || die "'jq' is required."
[ -d "$PAYLOAD" ] || die "payload missing at $PAYLOAD -- is this the Friday repo?"

# sha256 under either coreutils or BSD; the project has been bitten before by
# assuming one layout, so neither is assumed here.
if command -v sha256sum >/dev/null; then
  sha256_in() { sha256sum | cut -d' ' -f1; }
elif command -v shasum >/dev/null; then
  sha256_in() { shasum -a 256 | cut -d' ' -f1; }
else
  die "need sha256sum or shasum"
fi
sha256() { sha256_in < "$1"; }

# Where the payload is read from. By default, this checkout's working tree,
# which is what install.sh has just copied and what a person checking by hand
# expects. With FRIDAY_TREE=<commit>, everything -- the managed-core list, each
# payload file, and the commit the lock records -- comes from that commit
# instead, so a caller that pins one commit sees one payload however the
# working tree changes meanwhile. friday-propagate does that (#29).
TREE=${FRIDAY_TREE:-}
if [ -n "$TREE" ]; then
  git -C "$KIT_ROOT" cat-file -e "${TREE}^{commit}" 2>/dev/null \
    || die "FRIDAY_TREE is not a commit in $KIT_ROOT: $TREE"
  list_text=$(git -C "$KIT_ROOT" show "$TREE:bin/managed-core.txt" 2>/dev/null) \
    || die "no bin/managed-core.txt at $TREE"
  payload_files() {
    git -C "$KIT_ROOT" -c core.quotePath=false ls-tree -r --name-only "$TREE" -- payload/ |
      while IFS= read -r f; do printf '%s\n' "${f#payload/}"; done
  }
  payload_has() { git -C "$KIT_ROOT" cat-file -e "$TREE:payload/$1" 2>/dev/null; }
  payload_sha() { git -C "$KIT_ROOT" show "$TREE:payload/$1" | sha256_in; }
else
  [ -f "$LIST" ] || die "missing $LIST"
  list_text=$(cat "$LIST")
  payload_files() { find "$PAYLOAD" -type f -print | while IFS= read -r f; do printf '%s\n' "${f#"$PAYLOAD"/}"; done; }
  payload_has() { [ -f "$PAYLOAD/$1" ]; }
  payload_sha() { sha256 "$PAYLOAD/$1"; }
fi

managed=()
owned=()
while IFS= read -r line; do
  line=${line%%#*}
  line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  [ -n "$line" ] || continue
  case "$line" in
    '!'*) owned+=("${line#!}") ;;
    *)    managed+=("$line") ;;
  esac
done <<< "$list_text"
[ ${#managed[@]} -gt 0 ] || die "no managed-core entries in $LIST"

# Every payload file must be classified. An unclassified one would be shipped
# to consumers and never compared -- exactly the gap that let three githooks
# sit outside the byte-exact set while the docs still said eleven.
unclassified=0
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  found=0
  for m in "${managed[@]}"; do [ "$m" = "$rel" ] && found=1 && break; done
  if [ "$found" -eq 0 ]; then
    for o in "${owned[@]}"; do [ "$o" = "$rel" ] && found=1 && break; done
  fi
  [ "$found" -eq 1 ] || { echo "friday-lock: payload file is classified neither managed nor consumer-owned: $rel" >&2; unclassified=1; }
done < <(payload_files)
[ "$unclassified" -eq 0 ] || die "classify it in $LIST before this tool can be trusted."

for m in "${managed[@]}"; do
  payload_has "$m" || die "managed-core entry has no payload file: $m"
done

is_managed() {
  local m
  for m in "${managed[@]}"; do [ "$m" = "$1" ] && return 0; done
  return 1
}

# The commit that last touched the payload, not Friday's HEAD. The lock
# answers "which payload am I on", and a Friday commit that changes only a
# README changes no payload byte -- recording HEAD there would point a
# consumer at a commit that explains nothing about what it holds, and, when
# the lock is written from a feature branch, at a commit not yet on main.
# This is the same reasoning that makes `behind` a content comparison.
friday_commit() {
  git -C "$KIT_ROOT" log -1 --format=%H ${TREE:+"$TREE"} -- payload/ 2>/dev/null || printf 'unknown\n'
}

# --- write -------------------------------------------------------------------
write_lock() {
  local target=$1 rel json
  [ -d "$target" ] || die "no such target: $target"
  target=$(cd "$target" && pwd -P)

  json=$(jq -n --arg commit "$(friday_commit)" --arg date "$(date -u +%Y-%m-%d)" \
    '{friday:{repo:"ShenYo/Friday",commit:$commit,synced:$date},managed_core:{}}')

  # FRIDAY_LOCK_FROM_INDEX=1 records what the target's index holds -- the
  # content its next commit will carry -- instead of the working tree, so an
  # unstaged edit cannot be written into the record of a commit without it.
  local h
  for rel in "${managed[@]}"; do
    if [ -n "${FRIDAY_LOCK_FROM_INDEX:-}" ]; then
      git -C "$target" cat-file -e ":$rel" 2>/dev/null || continue
      h=$(git -C "$target" show ":$rel" | sha256_in)
    else
      [ -f "$target/$rel" ] || continue
      h=$(sha256 "$target/$rel")
    fi
    json=$(printf '%s' "$json" | jq --arg k "$rel" --arg v "$h" '.managed_core[$k] = $v')
  done

  [ "$(printf '%s' "$json" | jq '.managed_core | length')" -gt 0 ] \
    || die "$target has no managed-core file -- it is not a payload consumer, nothing to record."

  # Write through a temporary file in the same directory, so a reader either
  # sees the previous record or the new one and never a half-written file, and
  # an interrupted run never leaves the target with no record at all.
  local tmp="$target/.${CONSUMER_LOCK}.tmp.$$"
  printf '%s\n' "$json" > "$tmp" || die "could not write $tmp"
  mv -f "$tmp" "$target/$CONSUMER_LOCK" || { rm -f "$tmp"; die "could not install $target/$CONSUMER_LOCK"; }
  echo "wrote $target/$CONSUMER_LOCK"
}

# A Friday record is identified by its contents, never by its filename.
is_friday_record() {
  jq -e '(.friday.repo? // "") == "ShenYo/Friday" and (.friday.commit? | type) == "string"' \
    "$1" >/dev/null 2>&1
}

# --- check -------------------------------------------------------------------
check_lock() {
  local target=${1:-.} lock rel want have pwant
  [ -d "$target" ] || die "no such target: $target"
  target=$(cd "$target" && pwd -P)
  lock="$target/$CONSUMER_LOCK"
  [ -f "$lock" ] || die "no $CONSUMER_LOCK in $target -- run 'friday-lock write $target' first."
  jq -e . "$lock" >/dev/null 2>&1 || die "$(basename "$lock") is not valid JSON"
  # Valid JSON at the right path is not a record. An unrelated file -- or a
  # truncated one -- used to reach the end of this function and report
  # "in sync" over zero files, which is the worst possible answer: a green
  # light from a check that examined nothing.
  is_friday_record "$lock" \
    || die "$(basename "$lock") is not a Friday record (no .friday.repo/.friday.commit) -- run 'friday-lock write $target' or remove it."
  [ "$(jq -r '.managed_core // {} | length' "$lock")" -gt 0 ] \
    || die "$(basename "$lock") records no files -- nothing to check. Run 'friday-lock write $target'."

  local -a drifted=() behind=() retired=() recorded_rels=()

  # The lock is read against the managed core, in both directions. Iterating
  # only the lock's own entries saw neither a file that joined the managed core
  # after the lock was written nor one that left it: both read "in sync".
  while IFS=$'\t' read -r rel want; do
    [ -n "$rel" ] || continue
    recorded_rels+=("$rel")
    if ! is_managed "$rel"; then
      retired+=("$rel")
      continue
    fi
    if [ ! -f "$target/$rel" ]; then
      drifted+=("$rel (missing)")
      continue
    fi
    have=$(sha256 "$target/$rel")
    [ "$have" = "$want" ] || drifted+=("$rel")
    # The payload moving is a separate axis from the target being edited.
    if payload_has "$rel"; then
      pwant=$(payload_sha "$rel")
      [ "$pwant" = "$want" ] || behind+=("$rel")
    fi
  done < <(jq -r '.managed_core // {} | to_entries[] | "\(.key)\t\(.value)"' "$lock")

  local m r seen
  for m in "${managed[@]}"; do
    seen=0
    for r in ${recorded_rels+"${recorded_rels[@]}"}; do [ "$r" = "$m" ] && seen=1 && break; done
    [ "$seen" -eq 1 ] || behind+=("$m (new in the payload)")
  done

  # Content alone says the two differ, never which is newer. The recorded
  # payload commit does: if Friday's current payload commit is an ancestor of
  # the one the lock holds, the consumer is carrying something Friday has not
  # merged yet -- it is AHEAD, and copying the payload over it would silently
  # revert work. `friday-propagate` relies on this distinction.
  local direction=behind lock_commit cur_commit
  lock_commit=$(jq -r '.friday.commit // "unknown"' "$lock")
  cur_commit=$(friday_commit)
  if [ "$lock_commit" != unknown ] && [ "$cur_commit" != unknown ] \
     && [ "$lock_commit" != "$cur_commit" ] \
     && git -C "$KIT_ROOT" cat-file -e "${lock_commit}^{commit}" 2>/dev/null; then
    if git -C "$KIT_ROOT" merge-base --is-ancestor "$cur_commit" "$lock_commit" 2>/dev/null; then
      # The consumer recorded a payload Friday's checkout does not contain yet.
      direction=ahead
    elif ! git -C "$KIT_ROOT" merge-base --is-ancestor "$lock_commit" "$cur_commit" 2>/dev/null; then
      # Neither contains the other. Two payload lines exist -- typically an
      # unmerged branch on one side or the other -- and nothing here can say
      # which should win.
      direction=diverged
    fi
  fi

  local recorded
  recorded=$(jq -r '.managed_core // {} | length' "$lock")
  echo "target:  $target"
  echo "friday:  $(jq -r '.friday.commit' "$lock") (synced $(jq -r '.friday.synced' "$lock"))"
  echo "checked: $recorded file(s)"

  if [ ${#drifted[@]} -gt 0 ]; then
    echo ""
    echo "DRIFTED -- these no longer match what the lock recorded:"
    printf '  %s\n' "${drifted[@]}"
  fi
  if [ ${#behind[@]} -gt 0 ]; then
    echo ""
    case "$direction" in
      ahead)    echo "AHEAD -- this consumer holds a payload Friday has not merged yet:" ;;
      diverged) echo "DIVERGED -- this consumer and Friday hold different payload lines:" ;;
      *)        echo "BEHIND -- Friday's payload moved on these since the lock was written:" ;;
    esac
    printf '  %s\n' "${behind[@]}"
  fi
  if [ ${#retired[@]} -gt 0 ]; then
    echo ""
    echo "RETIRED -- the lock records these, and Friday no longer manages them:"
    printf '  %s\n' "${retired[@]}"
  fi

  if [ ${#drifted[@]} -gt 0 ]; then
    echo ""
    echo "status: drifted"
    return 1
  fi
  if [ ${#behind[@]} -gt 0 ]; then
    echo ""
    echo "status: $direction"
    case "$direction" in
      ahead)    echo "Friday has not merged this yet. Do not copy the payload over it." ;;
      diverged) echo "Reconcile the two payload lines before syncing either way; check out the Friday branch you mean to carry." ;;
      *)        echo "Take the change in a reviewed consumer commit, then re-run 'friday-lock write'." ;;
    esac
    return 1
  fi
  if [ ${#retired[@]} -gt 0 ]; then
    echo ""
    case "$direction" in
      ahead|diverged)
        echo "status: $direction"
        echo "Friday's checkout may simply not have these yet. Check out the Friday branch you mean to carry." ;;
      *)
        echo "status: retired"
        echo "Delete each file or keep it as this repository's own -- a person's call -- then re-run 'friday-lock write'." ;;
    esac
    return 1
  fi
  echo ""
  echo "status: in sync"
  return 0
}

case "${1:-}" in
  write) shift; [ $# -ge 1 ] || die "usage: friday-lock write <target>"; write_lock "$1" ;;
  check) shift; check_lock "${1:-.}" ;;
  *) echo "usage: friday-lock write <target> | friday-lock check [<target>]" >&2; exit 2 ;;
esac
