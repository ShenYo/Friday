#!/bin/bash
# Refuse a commit whose staged content looks like it carries a secret.
#
# This is a Git hook rather than a runtime tool hook because a runtime hook
# sees only the command string: `git commit -F -` passes its message on stdin,
# and `git commit` stages nothing by itself, so neither the message nor the
# staged diff is visible there. A Git hook sees both, and it covers commits a
# person makes by hand as well as an agent's.
#
# Scope is staged content only. A secret already in history is out of reach
# here and cannot be removed by an agent at all, since that needs a history
# rewrite and a force push, both permanently prohibited. See
# .agents/docs/git-guideline/safety-boundary.md.
#
# Note for maintainers: the rule table below is fed straight into a `while`
# loop. Do not wrap it in `$(...)` — bash scans heredoc bodies for quote pairs
# inside command substitution even when the delimiter is quoted, and these
# patterns contain unbalanced quotes.

set -uo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
export PATH

refuse() {
  echo "COMMIT REFUSED: $1" >&2
  echo "" >&2
  echo "Nothing was committed. See .agents/docs/git-guideline/safety-boundary.md" >&2
  echo "(Check for sensitive information). Do not reach for --no-verify: the" >&2
  echo "collaborative Git guard refuses that flag." >&2
  exit 1
}

for required in git grep awk sort; do
  command -v "$required" >/dev/null 2>&1 \
    || refuse "required executable unavailable: $required (failing closed)"
done

git rev-parse --git-dir >/dev/null 2>&1 \
  || refuse "not inside a Git repository (failing closed)"

# Added and changed lines only. Deleting a line that held a secret is how a
# secret gets removed, so scanning removals would refuse the fix.
staged_diff=$(git diff --cached --no-color --diff-filter=d -U0 2>/dev/null) \
  || refuse "unable to read the staged diff (failing closed)"

# Two exemptions, both narrow, because a scanner that cannot describe its own
# rules is a scanner nobody can maintain:
#
#  - this file is the rule table, so its added lines are patterns by
#    definition and are never scanned;
#  - any single line carrying the marker below is skipped, for a documented
#    example or a test fixture that must look like the real thing.
#
# The marker is deliberately per-line and must be justified where it appears.
# It is not a file-level or directory-level opt-out.
added=$(printf '%s\n' "$staged_diff" | awk '
    /^\+\+\+ / { f = $2; sub(/^b\//, "", f); skip = (f == ".agents/githooks/pre-commit"); next }
    /^\+/ && $0 !~ /^\+\+\+/ {
      if (skip) next
      if (index($0, "secret-scan:allow") > 0) next
      print
    }
  ')

findings=""
while IFS="	" read -r label pattern; do
  [ -n "${label:-}" ] || continue
  [ -n "${pattern:-}" ] || continue
  printf '%s\n' "$added" | grep -Eq -- "$pattern" || continue
  # Name the rule and the files, never the matched value.
  where=$(printf '%s\n' "$staged_diff" | awk -v pat="$pattern" '
      /^\+\+\+ / { f = $2; sub(/^b\//, "", f); skip = (f == ".agents/githooks/pre-commit"); next }
      /^\+/ && $0 !~ /^\+\+\+/ {
        if (skip) next
        if (index($0, "secret-scan:allow") > 0) next
        if ($0 ~ pat) print f
      }
    ' | sort -u | tr '\n' ' ')
  findings="${findings}  - ${label}: ${where:-(staged diff)}
"
done <<'RULES'
private key block	-----BEGIN ([A-Z ]+ )?PRIVATE KEY( BLOCK)?-----
OpenSSH private key	-----BEGIN OPENSSH PRIVATE KEY-----
AWS access key id	(^|[^A-Za-z0-9])(AKIA|ASIA)[0-9A-Z]{16}([^A-Za-z0-9]|$)
GitHub token	(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})
Slack token	xox[abprs]-[0-9A-Za-z-]{10,}
Google API key	AIza[0-9A-Za-z_-]{35}
Stripe secret key	(^|[^A-Za-z0-9])sk_(live|test)_[0-9A-Za-z]{16,}
Anthropic API key	sk-ant-[A-Za-z0-9_-]{20,}
JSON Web Token	(^|[^A-Za-z0-9])eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
assigned secret literal	(password|passwd|secret|api[_-]?key|apikey|access[_-]?token|auth[_-]?token|client[_-]?secret|private[_-]?key)[ "']{0,2}[:=][ "']{0,2}[A-Za-z0-9/+_=-]{12,}
credentials in a URL	[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]:@/]+:[^[:space:]@/]+@[^[:space:]/]+
RULES

if [ -n "$findings" ]; then
  echo "COMMIT REFUSED: staged changes look like they carry a secret." >&2
  echo "" >&2
  printf '%s' "$findings" >&2
  echo "" >&2
  echo "The matched values are deliberately not printed. Remove the value," >&2
  echo "unstage the file, or move it to an ignored path." >&2
  echo "" >&2
  echo "If a value is genuinely not a secret, say which rule and why rather" >&2
  echo "than bypassing the check." >&2
  echo "" >&2
  echo "If a real secret already reached a commit or a remote, treat it as" >&2
  echo "compromised and rotate it: an agent cannot remove it from history." >&2
  exit 1
fi

# Newly added files of a kind that normally holds credentials, judged by name
# rather than content. Already-tracked files are left alone, so a repository
# that made that choice deliberately is not second-guessed on every commit.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    .env|.env.*|*/.env|*/.env.*|*.pem|*.key|*.p12|*.pfx|*id_rsa|*id_ed25519|*.keystore|*.jks)
      refuse "newly added file '$f' is the kind that normally holds credentials. Add it to .gitignore, or confirm it carries none and is meant to be tracked."
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=A 2>/dev/null || true)

exit 0
