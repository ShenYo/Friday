#!/usr/bin/env bash
# Fail when a release that changed a consumer-owned seed has no "Seed changes"
# section in its changelog entry.
#
#   bin/friday-seed-check
#
# A seed is a `!` entry of bin/managed-core.txt, and lives under payload/.
# Propagation never writes one, so a release that changes one needs a hand
# edit in every consumer, and the entry must say which (CHANGELOG.md has the
# format). Two things are checked, from Git:
#
#   each release tag from FLOOR on   the range from the release before it
#                                    (the nearest vMAJOR.MINOR.PATCH tag
#                                    reachable from its commit) to the tag
#   the pending entry                the range from the newest release
#                                    reachable from HEAD to HEAD; the entry is
#                                    the top `## ` section of the newest
#                                    docs/changelog/vN.md, whether it is still
#                                    `## Unreleased` or already renamed for a
#                                    tag that is not cut yet
#
# A range that touches a seed needs, in the entry for that release, a
# "### Seed changes" section with the four fields (Capability, Who is
# affected, Action, Check), each with text on its line. Releases before FLOOR
# are not asked for anything. The entry is read from the working tree.
#
# Needs the release tags, so a shallow clone is refused: in CI, check out with
# fetch-depth: 0.
set -uo pipefail

KIT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
FLOOR=v1.2.0
RELEASE_RE='^v[0-9]+\.[0-9]+\.[0-9]+$'
FIELDS=("Capability" "Who is affected" "Action" "Check")

die() { echo "friday-seed-check: $*" >&2; exit 2; }
g() { git -C "$KIT_ROOT" "$@"; }

[ "$(g rev-parse --is-shallow-repository 2>/dev/null)" = false ] \
  || die "this clone is shallow or not a repository, so the release tags cannot be trusted: fetch the full history and tags."

# The "### Seed changes" section of one entry ("Unreleased" or a version) in a
# changelog read from stdin, heading line included; nothing when there is none.
# friday-propagate applies the same rule.
seed_section() {
  awk -v v="$1" '
    /^## / { insec = ($2 == v); inseed = 0; next }
    insec && /^### / { inseed = ($0 ~ /^### Seed changes[ \t]*$/) }
    inseed { print }'
}

# Seeds as payload/ paths, from the tree of the given commit.
seed_paths() {
  g show "$1:bin/managed-core.txt" 2>/dev/null | while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    case "$line" in '!'*) printf 'payload/%s\n' "${line#!}" ;; esac
  done
}

changelog_text() {
  local f
  for f in "$KIT_ROOT"/docs/changelog/v[0-9]*.md; do [ -f "$f" ] && cat "$f"; done
}

# touched <from-commit> <to-commit>: the seeds that differ, one per line.
touched() {
  local paths=() p
  while IFS= read -r p; do paths+=("$p"); done < <(seed_paths "$2")
  [ ${#paths[@]} -gt 0 ] || return 0
  g diff --name-only "$1" "$2" -- "${paths[@]}"
}

failures=0
# verify <label> <entry-name> <seeds-touched>
verify() {
  local label=$1 entry=$2 files=$3 section f
  section=$(changelog_text | seed_section "$entry")
  if [ -z "$section" ]; then
    echo "FAIL $label: changed a seed ($(printf '%s' "$files" | tr '\n' ' ' | sed 's/ $//')) but its changelog entry ($entry) has no '### Seed changes' section"
    failures=$((failures + 1)); return
  fi
  local bad=0
  for f in "${FIELDS[@]}"; do
    if ! printf '%s\n' "$section" | grep -Eq "^- \*\*$f:\*\*[[:space:]]*[^[:space:]]"; then
      echo "FAIL $label: the Seed changes section of $entry has no '- **$f:** <text>' field"
      failures=$((failures + 1)); bad=1
    fi
  done
  [ "$bad" = 0 ] || return
  echo "ok   $label: Seed changes section present ($(printf '%s' "$files" | tr '\n' ' ' | sed 's/ $//'))"
}

tags=$(g tag -l 'v[0-9]*' --sort=v:refname | grep -E "$RELEASE_RE")
[ -n "$tags" ] || die "no release tag (vMAJOR.MINOR.PATCH) in this clone: fetch the tags."

started=0
for t in $tags; do
  [ "$t" = "$FLOOR" ] && started=1
  [ "$started" = 1 ] || continue
  prev=$(g describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' --exclude 'v*-*' "refs/tags/$t^{commit}^" 2>/dev/null)
  [ -n "$prev" ] || { echo "skip $t: no release before it"; continue; }
  files=$(touched "refs/tags/$prev^{commit}" "refs/tags/$t^{commit}")
  if [ -z "$files" ]; then echo "ok   $t: no seed changed since $prev"; continue; fi
  verify "$t" "$t" "$files"
done

last=$(g describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' --exclude 'v*-*' HEAD 2>/dev/null)
if [ -n "$last" ]; then
  files=$(touched "refs/tags/$last^{commit}" HEAD)
  if [ -z "$files" ]; then
    echo "ok   pending: no seed changed since $last"
  else
    newest=$(ls "$KIT_ROOT"/docs/changelog/v[0-9]*.md 2>/dev/null | sed -n 's#.*/v\([0-9][0-9]*\)\.md$#\1 &#p' | sort -n | tail -1 | cut -d' ' -f2)
    top=""
    [ -n "$newest" ] && top=$(awk '/^## / { print $2; exit }' "$newest")
    if [ -z "$top" ]; then
      echo "FAIL pending: changed a seed since $last but there is no changelog entry to hold the Seed changes section"
      failures=$((failures + 1))
    elif [ "$top" != Unreleased ] && g rev-parse -q --verify "refs/tags/$top" >/dev/null; then
      echo "FAIL pending: changed a seed since $last, but the top changelog entry ($top) is already released: add '## Unreleased' with a Seed changes section"
      failures=$((failures + 1))
    else
      verify "pending" "$top" "$files"
    fi
  fi
fi

[ "$failures" -eq 0 ] || { echo "friday-seed-check: $failures problem(s)"; exit 1; }
echo "friday-seed-check: ok"
