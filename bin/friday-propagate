#!/usr/bin/env bash
# Carry a managed-core change out to consumers, as pull requests.
#
#   bin/friday-propagate [--dry-run] <consumer-path>...
#
# What it does per consumer: ask friday-lock where it stands, and only when it
# is `behind`, branch from its main, copy the managed-core files whose content
# moved, refresh the lock, commit, push and open a pull request.
#
# What it never does:
#
#   merge            the human review checkpoint is the one control in this
#                    platform that has never been bypassed, and a propagation
#                    tool is a poor place to start
#   touch a drifted  `drifted` means somebody edited a managed-core file in
#   consumer         that repository. Copying over it would destroy the edit
#                    and the reason for it. Reported and skipped.
#   force-push       never; nor does it touch an existing branch
#   work on a dirty  a consumer with uncommitted changes is refused outright
#   tree             rather than stashed around
#
# Why this runs here and not in CI: the four repositories span three accounts,
# and two of them -- the consumers -- are private, so a CI-hosted bot needs a
# cross-repository PAT with write access to all of them, sitting in a secret.
# Write access is the point, not visibility: opening a pull request needs it
# even on a public repository. This machine's `gh` already has
# that access, scoped to a person rather than to an always-on workflow, and
# the end result is identical -- pull requests a human still merges. See
# issue #7.
set -uo pipefail

KIT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PAYLOAD="$KIT_ROOT/payload"
LOCK="$KIT_ROOT/bin/friday-lock"
BRANCH_PREFIX=chore/sync-managed-core
CONSUMER_LOCK=.friday-lock.json
dry_run=false

die() { echo "friday-propagate: $*" >&2; exit 2; }
note() { printf '  %s\n' "$*"; }

[ "${1:-}" = "--dry-run" ] && { dry_run=true; shift; }
[ $# -ge 1 ] || die "usage: friday-propagate [--dry-run] <consumer-path>..."
command -v gh >/dev/null || die "'gh' is required to open pull requests."
[ -x "$LOCK" ] || die "missing $LOCK"

# Read once, then use only what was read (#29). The run pins one commit of
# Friday's main and takes everything from that commit's tree: which files are
# managed, their content and mode, what friday-lock compares against, and the
# commit the consumer's lock records. An uncommitted edit here, or a commit
# made while the run is going, cannot reach a consumer or disagree with the
# label it is shipped under.
[ "$(git -C "$KIT_ROOT" symbolic-ref --short -q HEAD)" = main ] \
  || die "run from Friday's main: the commit carried out is the one checked out here."
tree=$(git -C "$KIT_ROOT" rev-parse --verify -q HEAD) || die "cannot read Friday's HEAD"
payload_commit=$(git -C "$KIT_ROOT" log -1 --format=%H "$tree" -- payload/ 2>/dev/null)
[ -n "$payload_commit" ] || die "cannot read Friday's payload history"
short=${payload_commit:0:7}
export FRIDAY_TREE=$tree
# friday-lock itself comes from the pin as well: a commit that changes it
# mid-run must not change the rules a later consumer is judged and recorded by.
LOCK=$(mktemp "${TMPDIR:-/tmp}/friday-lock.XXXXXX") || die "cannot create a temporary file"
trap 'rm -f "$LOCK"' EXIT
git -C "$KIT_ROOT" show "$tree:bin/friday-lock" > "$LOCK" || die "no bin/friday-lock at $tree"
export FRIDAY_KIT_ROOT=$KIT_ROOT
if [ -n "$(git -C "$KIT_ROOT" status --porcelain -- payload/ bin/managed-core.txt)" ]; then
  echo "friday-propagate: note: uncommitted payload changes here are not carried; only $short is." >&2
fi

blob() { git -C "$KIT_ROOT" show "$tree:payload/$1"; }
blob_mode() { git -C "$KIT_ROOT" ls-tree "$tree" -- "payload/$1" | cut -d' ' -f1; }

# The managed core is classified in one place; this reads it rather than
# carrying a second copy that could disagree.
managed=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  case "$line" in ''|'!'*) continue ;; esac
  managed+=("$line")
done < <(git -C "$KIT_ROOT" show "$tree:bin/managed-core.txt")

opened=0; skipped=0; refused=0

for target in "$@"; do
  [ -d "$target" ] || { echo "friday-propagate: no such path: $target" >&2; refused=$((refused + 1)); continue; }
  target=$(cd "$target" && pwd -P)
  name=$(basename "$target")
  echo "$name"

  status=$(bash "$LOCK" check "$target" 2>&1)
  state=$(printf '%s' "$status" | grep '^status:' | sed 's/status: //')

  case "$state" in
    "in sync")
      note "in sync — nothing to carry"; skipped=$((skipped + 1)); continue ;;
    drifted)
      note "DRIFTED — a managed-core file was edited in this repository."
      printf '%s' "$status" | sed -n '/^DRIFTED/,/^$/p' | sed 's/^/    /'
      note "Reconcile it by hand first. Nothing was touched."
      refused=$((refused + 1)); continue ;;
    ahead)
      note "AHEAD — this consumer holds a payload Friday has not merged yet."
      note "Copying over it would silently revert that work. Nothing was touched."
      refused=$((refused + 1)); continue ;;
    diverged)
      note "DIVERGED — this consumer and Friday hold different payload lines."
      note "Check out the Friday branch you mean to carry. Nothing was touched."
      refused=$((refused + 1)); continue ;;
    retired)
      note "RETIRED — the lock records files Friday no longer manages:"
      printf '%s' "$status" | sed -n '/^RETIRED/,/^$/p' | sed '1d;/^$/d;s/^/  /'
      note "Deleting each one or keeping it as this repository's own is the owner's call."
      note "Nothing was touched."
      refused=$((refused + 1)); continue ;;
    behind) ;;
    *)
      note "could not read a status from friday-lock:"; printf '%s\n' "$status" | sed 's/^/    /'
      refused=$((refused + 1)); continue ;;
  esac

  # Branch state is read before anything is decided: the lock compares against
  # whatever the consumer currently has checked out, so a consumer sitting on a
  # feature branch is being judged on work that is not on its main.
  consumer_branch=$(git -C "$target" branch --show-current 2>/dev/null)
  if [ "$consumer_branch" != main ]; then
    note "REFUSED — this consumer is on '$consumer_branch', not main."
    note "The lock was read against that branch, not against what would be branched from."
    refused=$((refused + 1)); continue
  fi

  # Which files actually moved. Only these are copied -- a consumer's own
  # files are never in this list, because only managed core is. A repository
  # with no .friday-lock.json, or one that records no managed core, never
  # reaches here: friday-lock refuses to give it a status. A .agents/
  # directory alone is not a consumer; a repository may keep one for
  # something else.
  moved=()
  for rel in "${managed[@]}"; do
    [ -f "$target/$rel" ] || { moved+=("$rel"); continue; }
    blob "$rel" | cmp -s - "$target/$rel" || moved+=("$rel")
  done

  # A file that joined the managed core may already exist here as this
  # repository's own -- a seed that became managed, say. Copying over it
  # would replace work nobody reviewed losing, so that is the owner's call.
  # One that already matches needs no copy, only a lock entry.
  added=()
  while IFS= read -r rel; do [ -n "$rel" ] && added+=("$rel"); done < <(
    printf '%s\n' "$status" | sed -n 's/^  \(.*\) (new in the payload)$/\1/p')
  own=""
  for rel in ${added+"${added[@]}"}; do
    if [ -f "$target/$rel" ] && ! blob "$rel" | cmp -s - "$target/$rel"; then own="$own $rel"; fi
  done
  if [ -n "$own" ]; then
    note "REFUSED — joined the managed core, and this repository has its own version:$own"
    note "Reconcile each by hand, then run 'friday-lock write'. Nothing was touched."
    refused=$((refused + 1)); continue
  fi
  if [ ${#moved[@]} -eq 0 ] && [ ${#added[@]} -eq 0 ]; then
    note "behind, but no managed-core file differs — nothing to do"; skipped=$((skipped + 1)); continue
  fi

  if [ ${#moved[@]} -gt 0 ]; then
    note "behind on ${#moved[@]} file(s):"
    printf '    %s\n' "${moved[@]}"
  else
    note "behind only in the lock: these joined the managed core and already match:"
    printf '    %s\n' "${added[@]}"
  fi

  if [ -n "$(git -C "$target" status --porcelain 2>/dev/null)" ]; then
    note "REFUSED — the working tree is not clean. Commit or stash first."
    refused=$((refused + 1)); continue
  fi

  branch="$BRANCH_PREFIX-$short"
  if git -C "$target" rev-parse --verify --quiet "$branch" >/dev/null \
     || git -C "$target" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    note "REFUSED — branch '$branch' already exists. Finish or delete it first."
    refused=$((refused + 1)); continue
  fi

  if $dry_run; then
    note "dry run — would open '$branch' with the files above"
    opened=$((opened + 1)); continue
  fi

  git -C "$target" checkout -q main 2>/dev/null || { note "REFUSED — no main branch"; refused=$((refused + 1)); continue; }
  git -C "$target" pull -q --ff-only origin main || { note "REFUSED — main is not fast-forwardable"; refused=$((refused + 1)); continue; }
  # Checked, because this script runs without `set -e`: an unchecked failure
  # here left the target on the main it had just pulled, and everything below
  # -- copy, stage, commit -- then landed on main. Reproduced by making the
  # branch creation fail: the consumer's main gained the sync commit.
  git -C "$target" checkout -q -b "$branch" || {
    note "REFUSED — could not create '$branch' (another run may hold it); main left untouched"
    refused=$((refused + 1)); continue
  }

  # What the branch now starts from is what was just pulled, not what was
  # read before. Ask again, against the same pinned tree: main may have gained
  # a commit that edited a managed file (drift the first check never saw), or
  # one that changes what has to be carried. Either way the earlier decision
  # no longer holds, and copying now would launder that edit into the lock.
  again=$(bash "$LOCK" check "$target" 2>&1)
  again_state=$(printf '%s' "$again" | sed -n 's/^status: //p')
  moved_again=()
  for rel in "${managed[@]}"; do
    [ -f "$target/$rel" ] || { moved_again+=("$rel"); continue; }
    blob "$rel" | cmp -s - "$target/$rel" || moved_again+=("$rel")
  done
  if [ "$again_state" != behind ] || [ "${moved_again[*]:-}" != "${moved[*]:-}" ]; then
    note "REFUSED — after pulling main the consumer reads '${again_state:-unknown}', not what was checked:"
    printf '%s\n' "$again" | sed -n -E '/^(DRIFTED|BEHIND|RETIRED)/,/^$/p' | sed 's/^/    /'
    git -C "$target" checkout -q main
    note "Nothing was written; the consumer is back on main. Run it again."
    refused=$((refused + 1)); continue
  fi

  # Another run, or a hook, may have moved HEAD since the branch was made.
  # Everything below writes into whatever is checked out, so it must be the
  # sync branch.
  if [ "$(git -C "$target" symbolic-ref --short -q HEAD)" != "$branch" ]; then
    note "REFUSED — HEAD is '$(git -C "$target" symbolic-ref --short -q HEAD || echo detached)', not '$branch'. Nothing was written."
    refused=$((refused + 1)); continue
  fi

  # The tree was clean when it was checked, but that was before the pull and
  # the branch. Look again at every file about to be written, all of them
  # before the first write, so a concurrent edit is refused, not overwritten.
  changed_since=""
  for rel in ${moved+"${moved[@]}"}; do
    [ -z "$(git -C "$target" status --porcelain -- "$rel")" ] || changed_since="$changed_since $rel"
  done
  if [ -n "$changed_since" ]; then
    note "REFUSED — changed in the consumer after it was checked:$changed_since"
    git -C "$target" checkout -q main
    note "Nothing was written; the consumer is back on main with the change in place."
    refused=$((refused + 1)); continue
  fi

  for rel in ${moved+"${moved[@]}"}; do
    mkdir -p "$target/$(dirname "$rel")"
    blob "$rel" > "$target/$rel.friday-sync.$$" && mv -f "$target/$rel.friday-sync.$$" "$target/$rel"
    if [ "$(blob_mode "$rel")" = 100755 ]; then chmod +x "$target/$rel"; else chmod -x "$target/$rel"; fi
    git -C "$target" add "$rel"
  done
  # Recorded from the index -- exactly what this commit will hold -- not from
  # the working tree, where an edit nobody staged would be written into the
  # lock and read back as drift by everyone who checks out the branch.
  FRIDAY_LOCK_FROM_INDEX=1 bash "$LOCK" write "$target" >/dev/null
  git -C "$target" add -- "$CONSUMER_LOCK"

  list=$(printf '  %s\n' ${moved+"${moved[@]}"})
  [ ${#moved[@]} -gt 0 ] || list="  (none: the lock alone moves; these joined the managed core and already
  match: ${added[*]})"
  # Files Friday stopped managing are left exactly where they are: deleting
  # them is the owner's call, so the pull request names them instead.
  retired_list=$(printf '%s' "$status" | sed -n '/^RETIRED/,/^$/p' | sed '1d;/^$/d;s/^ *//')
  retired_note=""
  if [ -n "$retired_list" ]; then
    retired_note="
No longer managed by Friday, and left in place. Delete each one or keep
it as this repository's own, deliberately:

\`\`\`
$retired_list
\`\`\`
"
  fi
  main_before=$(git -C "$target" rev-parse main)
  if [ "$(git -C "$target" symbolic-ref --short -q HEAD)" != "$branch" ]; then
    note "REFUSED — HEAD left '$branch' before the commit; the copied files are staged on '$(git -C "$target" symbolic-ref --short -q HEAD || echo detached)', nothing was committed or pushed"
    refused=$((refused + 1)); continue
  fi
  git -C "$target" commit -q -F - <<MSG
chore(agents): sync the managed core to Friday $short

Adopt the managed-core files whose content moved in Friday. Only the
files below changed; this repository's own seeds and overlays are
untouched.

$list
The lock is what identified them: friday-lock reported this repository
as behind and named each path before anything was copied.

Byte-identical to Friday payload at $payload_commit.
${FRIDAY_PROPAGATE_TRAILERS:+
$FRIDAY_PROPAGATE_TRAILERS}
MSG
  # A refused commit -- the target's own commit hooks run here -- must not be
  # followed by a push of a branch that carries nothing.
  if [ "$(git -C "$target" rev-parse main)" != "$main_before" ]; then
    note "STOPPED — main moved to $(git -C "$target" rev-parse --short main) during the commit; the sync commit may be on main. Nothing was pushed; inspect main before anything else."
    refused=$((refused + 1)); continue
  fi
  if ! git -C "$target" rev-parse --verify --quiet "$branch" >/dev/null \
     || [ "$(git -C "$target" rev-parse "$branch")" = "$main_before" ] \
     || [ "$(git -C "$target" symbolic-ref --short -q HEAD)" != "$branch" ]; then
    note "REFUSED — the commit did not land on '$branch' (a commit hook may have refused it); the copied files are staged, nothing was pushed"
    refused=$((refused + 1)); continue
  fi
  # The consumer goes back to main either way from here: the sync commit is
  # on its own branch, and leaving a person's checkout on it is a surprise.
  if ! git -C "$target" push -q -u origin "$branch" 2>/dev/null; then
    note "push failed"
    git -C "$target" checkout -q main
    refused=$((refused + 1)); continue
  fi

  if ! url=$(cd "$target" && gh pr create --base main --head "$branch" \
    --title "chore(agents): sync the managed core to Friday $short" \
    --body "Opened by \`friday-propagate\` from Friday \`$payload_commit\`.

Managed-core files whose content moved:

\`\`\`
${moved[*]:-(none — the lock alone moves; ${added[*]} joined the managed core and already match)}
\`\`\`

\`friday-lock\` reported this repository as \`behind\` and named each path
before anything was copied. This repository's own seeds and overlays are
untouched — only managed core is ever carried.
$retired_note

Verify before merging:

\`\`\`sh
bash ~/.Friday/bin/friday-lock check .
bash .agents/hooks/check-collaborative-git.sh
\`\`\`

This tool never merges. The human review checkpoint stands." 2>&1 | tail -1); then
    note "the branch is pushed, but opening the pull request failed:"
    note "  $url"
    note "open it by hand: cd $target && gh pr create --base main --head $branch"
    git -C "$target" checkout -q main
    refused=$((refused + 1))
    continue
  fi
  git -C "$target" checkout -q main
  note "opened $url"
  opened=$((opened + 1))
done

echo ""
# A dry run opens nothing, so it must not report that it did.
if $dry_run; then
  echo "would-open=$opened skipped=$skipped refused=$refused (dry run, nothing opened)"
else
  echo "opened=$opened skipped=$skipped refused=$refused"
fi
[ "$refused" -eq 0 ]
